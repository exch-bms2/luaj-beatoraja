+	/** Validates the OP_EXTRAARG that must follow OP_LOADKX and returns it. */
+	private static int extraArg(int i) {
+		if ((i & 0x3f) != Lua.OP_EXTRAARG) {
+			int op = i & 0x3f;
+			throw new LuaError("OP_EXTRAARG expected after OP_LOADKX, got " +
+				(op < Print.OPNAMES.length - 1 ? Print.OPNAMES[op] : "UNKNOWN_OP_" + op));
+		}
+		return i;
+	}
+
+	private static LuaValue concat(LuaValue[] stack, int b, int c) {
+		if ( c > b+1 ) {
+			Buffer sb = stack[c].buffer();
+			while ( --c>=b )
+				sb.concatTo(stack[c]);
+			return sb.value();
+		}
+		return stack[c-1].concat(stack[c]);
+	}
+
+	/** Closes open upvalues at or above register {@code level}. */
+	private static void closeUpvalues(UpValue[] openups, int level) {
+		for ( int b = openups.length; --b>=0; )
+			if (openups[b] != null && openups[b].index >= level) {
+				openups[b].close();
+				openups[b] = null;
+			}
+	}
+
+	private Varargs returnToTop(LuaValue[] stack, int a, int prefix, Varargs v, boolean detachedReturns) {
+		if (prefix == 0) return v;
+		if (detachedReturns && (globals == null || globals.debuglib == null) && Varargs.isOwnedArray(v))
+			return Varargs.prependCopy(stack, a, prefix, v);
+		return varargsOf(stack, a, prefix, v);
+	}
+
+	private Varargs returnFixed(LuaValue[] stack, int a, int n, boolean detachedReturns) {
+		// Debug return observers may still modify the live registers.
+		if (detachedReturns && (globals == null || globals.debuglib == null))
+			return Varargs.copyOf(stack, a, n);
+		return varargsOf(stack, a, n);
+	}
+
+	private static void forprep(LuaValue[] stack, int a) {
+		LuaValue init  = stack[a].checknumber("'for' initial value must be a number");
+		LuaValue limit = stack[a + 1].checknumber("'for' limit must be a number");
+		LuaValue step  = stack[a + 2].checknumber("'for' step must be a number");
+		stack[a] = init.sub(step);
+		stack[a + 1] = limit;
+		stack[a + 2] = step;
+	}
+
+	private static void tforcall(LuaValue[] stack, int a, int c) {
+		Varargs v = stack[a].invoke(varargsOf(stack[a+1],stack[a+2]));
+		while (--c >= 0)
+			stack[a+3+c] = v.arg(c+1);
+	}
+
+	private static void setlist(LuaValue[] stack, int a, int b, int c, int top, Varargs v) {
+		int offset = (c-1) * Lua.LFIELDS_PER_FLUSH;
+		LuaValue o = stack[a];
+		if ( b == 0 ) {
+			b = top - a - 1;
+			int m = b - v.narg();
+			int j=1;
+			for ( ;j<=m; j++ )
+				o.set(offset+j, stack[a + j]);
+			for ( ;j<=b; j++ )
+				o.set(offset+j, v.arg(j-m));
+		} else {
+			o.presize( offset + b );
+			for (int j=1; j<=b; j++)
+				o.set(offset+j, stack[a + j]);
+		}
+	}
