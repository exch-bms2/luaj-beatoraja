+	// Rarely executed parts of execute(), kept out of it so the hot loop stays small.
+
+	private void exitFrame(UpValue[] openups) {
+		if ( openups != null )
+			for ( int u=openups.length; --u>=0; )
+				if ( openups[u] != null )
+					openups[u].close();
+		if (globals != null && globals.debuglib != null)
+			globals.debuglib.onReturn();
+	}
