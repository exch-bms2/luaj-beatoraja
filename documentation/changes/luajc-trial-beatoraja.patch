diff --git a/src/bms/player/beatoraja/skin/lua/SkinLuaCompiler.java b/src/bms/player/beatoraja/skin/lua/SkinLuaCompiler.java
new file mode 100644
index 00000000..4fd3fe24
--- /dev/null
+++ b/src/bms/player/beatoraja/skin/lua/SkinLuaCompiler.java
@@ -0,0 +1,75 @@
+package bms.player.beatoraja.skin.lua;
+
+import java.io.IOException;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicLong;
+import java.util.logging.Logger;
+
+import org.luaj.vm2.Globals;
+import org.luaj.vm2.LuaClosure;
+import org.luaj.vm2.LuaFunction;
+import org.luaj.vm2.LuaValue;
+import org.luaj.vm2.Prototype;
+
+/**
+ * Opt-in LuaJC (Lua to JVM bytecode) for skin scripts: {@code -Dbeatoraja.luajc=true}.
+ * <p>
+ * Disabled by default. Needs BCEL on the classpath; without it the interpreter is used.
+ * A chunk that LuaJC cannot compile falls back to the interpreter, so a skin never fails
+ * to load because of the compiler. Known LuaJC differences: error messages carry no
+ * file:line, and string.dump does not work on compiled functions.
+ */
+public final class SkinLuaCompiler implements Globals.Loader {
+	private static final boolean REQUESTED = Boolean.getBoolean("beatoraja.luajc");
+	private static final boolean AVAILABLE = REQUESTED && bcelPresent();
+	private static final SkinLuaCompiler INSTANCE = AVAILABLE ? new SkinLuaCompiler() : null;
+
+	private static final AtomicLong compiled = new AtomicLong(), compileNanos = new AtomicLong(), fallbacks = new AtomicLong();
+	private static final AtomicBoolean warned = new AtomicBoolean();
+
+	SkinLuaCompiler() {}
+
+	private static boolean bcelPresent() {
+		try {
+			Class.forName("org.apache.bcel.generic.ClassGen", false, SkinLuaCompiler.class.getClassLoader());
+			Class.forName("org.luaj.vm2.luajc.LuaJC", false, SkinLuaCompiler.class.getClassLoader());
+			Logger.getGlobal().info("LuaJC enabled for skin scripts");
+			return true;
+		} catch (ClassNotFoundException | LinkageError e) {
+			Logger.getGlobal().warning("beatoraja.luajc=true but LuaJC/BCEL is not on the classpath; using the interpreter");
+			return false;
+		}
+	}
+
+	/** Installs LuaJC as the loader of {@code globals} when requested and available. */
+	static void install(Globals globals) {
+		if (INSTANCE != null) globals.loader = INSTANCE;
+	}
+
+	public static boolean isEnabled() { return INSTANCE != null; }
+
+	@Override
+	public LuaFunction load(Prototype prototype, String chunkname, LuaValue env) throws IOException {
+		long started = System.nanoTime();
+		try {
+			// loadVerified links every generated class and checks upvalue fields up front, so LuaJC
+			// bugs that would only fail on first call (VerifyError, NoSuchFieldError) fall back here.
+			LuaFunction f = org.luaj.vm2.luajc.LuaJC.instance.loadVerified(prototype, chunkname, env);
+			compiled.incrementAndGet();
+			return f;
+		} catch (RuntimeException | LinkageError | IOException e) {
+			fallbacks.incrementAndGet();
+			if (warned.compareAndSet(false, true))
+				Logger.getGlobal().warning("LuaJC could not compile a skin chunk, using the interpreter for it: "
+						+ e.getClass().getSimpleName() + ": " + e.getMessage());
+			return new LuaClosure(prototype, env);
+		} finally {
+			compileNanos.addAndGet(System.nanoTime() - started);
+		}
+	}
+
+	/** Chunks compiled, nanoseconds spent in code generation and class loading, and fallbacks. */
+	static long[] statistics() {
+		return new long[] {compiled.get(), compileNanos.get(), fallbacks.get()};
+	}
+}
diff --git a/test/bms/player/beatoraja/skin/lua/SkinLuaCompilerTest.java b/test/bms/player/beatoraja/skin/lua/SkinLuaCompilerTest.java
new file mode 100644
index 00000000..fd0899f5
--- /dev/null
+++ b/test/bms/player/beatoraja/skin/lua/SkinLuaCompilerTest.java
@@ -0,0 +1,46 @@
+package bms.player.beatoraja.skin.lua;
+
+import org.luaj.vm2.Globals;
+import org.luaj.vm2.LuaClosure;
+import org.luaj.vm2.LuaFunction;
+import org.luaj.vm2.LuaValue;
+import org.luaj.vm2.lib.jse.JsePlatform;
+
+/** Opt-in LuaJC loader: off by default, compiles with BCEL, falls back to the interpreter without it. */
+public final class SkinLuaCompilerTest {
+    public static void main(String[] args) throws Exception {
+        check(System.getProperty("beatoraja.luajc") == null, "test must run without the property");
+        check(!SkinLuaCompiler.isEnabled(), "disabled by default");
+        Globals g = JsePlatform.standardGlobals();
+        Globals.Loader before = g.loader;
+        SkinLuaCompiler.install(g);
+        check(g.loader == before, "install is a no-op when disabled");
+
+        boolean bcel = present("org.apache.bcel.generic.ClassGen");
+        g.loader = new SkinLuaCompiler();
+        long[] s0 = SkinLuaCompiler.statistics();
+        LuaValue chunk = g.load(
+                "local t = { a = 1.5, b = 7000 }\n" +
+                "local function f(n) if n == 0 then return t.a end return f(n - 1) end\n" +
+                "return function(x) return f(x) + t.b + select('#', 1, 2, 3) end", "skin-chunk");
+        LuaFunction fn = chunk.call().checkfunction();
+        check(fn.call(LuaValue.valueOf(5)).todouble() == 7004.5, "result: " + fn.call(LuaValue.valueOf(5)));
+        long[] s1 = SkinLuaCompiler.statistics();
+        if (bcel) {
+            check(!(fn instanceof LuaClosure), "compiled with LuaJC: " + fn.getClass());
+            check(s1[0] > s0[0] && s1[2] == s0[2], "counted as compiled");
+        } else {
+            check(fn instanceof LuaClosure, "interpreter fallback without BCEL: " + fn.getClass());
+            check(s1[2] > s0[2], "counted as fallback");
+        }
+        System.out.println("SkinLuaCompilerTest passed (" + (bcel ? "LuaJC" : "fallback") + ")");
+    }
+
+    private static boolean present(String name) {
+        try { Class.forName(name); return true; } catch (ClassNotFoundException e) { return false; }
+    }
+
+    private static void check(boolean ok, String message) {
+        if (!ok) throw new AssertionError(message);
+    }
+}
