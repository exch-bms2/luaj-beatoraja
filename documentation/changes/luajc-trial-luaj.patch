+
+	/**
+	 * Like {@link #load(Prototype, String, LuaValue)}, but rejects generated code that would
+	 * only fail when first executed. Every generated class is linked and verified now, and
+	 * every field reference between generated classes must match a declared field and type.
+	 * Callers can catch the exception and fall back to the interpreter for this chunk.
+	 * @throws IllegalStateException or LinkageError when the generated code is unusable
+	 */
+	public LuaFunction loadVerified(Prototype p, String name, LuaValue globals) throws IOException {
+		String luaname = toStandardLuaFileName( name );
+		String classname = toStandardJavaClassName( luaname );
+		JavaGen gen = new JavaGen( p, classname, luaname, false );
+		java.util.List<JavaGen> all = new java.util.ArrayList<JavaGen>();
+		flatten( gen, all );
+		checkFieldReferences( all );
+		JavaLoader loader = new JavaLoader();
+		loader.include( gen );
+		try {
+			for ( JavaGen g : all )
+				Class.forName( g.classname, true, loader );
+		} catch ( ClassNotFoundException e ) {
+			throw new IllegalStateException( "bad class gen: " + e );
+		}
+		return loader.load( gen.classname, globals );
+	}
+
+	private static void flatten(JavaGen gen, java.util.List<JavaGen> out) {
+		out.add( gen );
+		for ( int i=0, n=gen.inners!=null? gen.inners.length: 0; i<n; i++ )
+			flatten( gen.inners[i], out );
+	}
+
+	private static void checkFieldReferences(java.util.List<JavaGen> all) throws IOException {
+		java.util.Map<String,String> declared = new java.util.HashMap<String,String>();
+		java.util.List<org.apache.bcel.classfile.JavaClass> classes = new java.util.ArrayList<org.apache.bcel.classfile.JavaClass>();
+		for ( JavaGen g : all ) {
+			org.apache.bcel.classfile.JavaClass jc = new org.apache.bcel.classfile.ClassParser(
+					new java.io.ByteArrayInputStream( g.bytecode ), g.classname ).parse();
+			classes.add( jc );
+			org.apache.bcel.classfile.Field[] fields = jc.getFields();
+			for ( int i=0; i<fields.length; i++ )
+				declared.put( g.classname + "." + fields[i].getName(), fields[i].getSignature() );
+		}
+		for ( org.apache.bcel.classfile.JavaClass jc : classes ) {
+			org.apache.bcel.generic.ConstantPoolGen cp = new org.apache.bcel.generic.ConstantPoolGen( jc.getConstantPool() );
+			org.apache.bcel.classfile.Method[] methods = jc.getMethods();
+			for ( int i=0; i<methods.length; i++ ) {
+				if ( methods[i].getCode() == null )
+					continue;
+				org.apache.bcel.generic.InstructionHandle[] ih =
+					new org.apache.bcel.generic.InstructionList( methods[i].getCode().getCode() ).getInstructionHandles();
+				for ( int j=0; j<ih.length; j++ ) {
+					if ( !(ih[j].getInstruction() instanceof org.apache.bcel.generic.FieldInstruction) )
+						continue;
+					org.apache.bcel.generic.FieldInstruction fi = (org.apache.bcel.generic.FieldInstruction) ih[j].getInstruction();
+					String owner = fi.getReferenceType( cp ).toString();
+					String key = owner + "." + fi.getFieldName( cp );
+					if ( isGenerated( owner, all ) ) {
+						if ( !fi.getSignature( cp ).equals( declared.get( key ) ) )
+							throw new IllegalStateException( "bad class gen: inconsistent field " + key );
+					}
+				}
+			}
+		}
+	}
+
+	private static boolean isGenerated(String classname, java.util.List<JavaGen> all) {
+		for ( JavaGen g : all )
+			if ( g.classname.equals( classname ) )
+				return true;
+		return false;
+	}
 	
